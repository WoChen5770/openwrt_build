+# New hostapd releases place BSS sockets below a numbered subdirectory.
+# Find the directory with the most BSS sockets before DAWN starts.
+find_hostapd_dir()
+{
+	local base_dir=/var/run/hostapd
+	local best_dir=''
+	local best_count=0
+	local candidate socket socket_count
+
+	[ -d "$base_dir" ] || return 1
+	for candidate in "$base_dir" "$base_dir"/*; do
+		[ -d "$candidate" ] || continue
+		socket_count=0
+		for socket in "$candidate"/*; do
+			[ -S "$socket" ] || continue
+			[ "${socket##*/}" = "global" ] && continue
+			socket_count=$((socket_count + 1))
+		done
+		[ "$socket_count" -gt 0 ] || continue
+		if [ "$socket_count" -gt "$best_count" ]; then
+			best_dir="$candidate"
+			best_count="$socket_count"
+		fi
+	done
+	[ -n "$best_dir" ] || return 1
+	printf '%s\n' "$best_dir"
+}
+
+# Also correct kept-config upgrades: periodic beacon requests crash some
+# DAWN builds, and the hostapd run directory is a property of the firmware.
+apply_runtime_fixes()
+{
+	local changed=0
+	local current
+	local hostapd_dir
+	local section
+
+	hostapd_dir="$(find_hostapd_dir 2>/dev/null || true)"
+	if [ -n "$hostapd_dir" ]; then
+		for section in $(uci show dawn | sed -n 's/^dawn\.\([^.=]*\)=hostapd$/\1/p'); do
+			current="$(uci -q get "dawn.$section.hostapd_dir" || true)"
+			if [ "$current" != "$hostapd_dir" ]; then
+				uci set "dawn.$section.hostapd_dir=$hostapd_dir" || return 1
+				changed=1
+			fi
+		done
+	fi
+
+	for section in $(uci show dawn | sed -n 's/^dawn\.\([^.=]*\)=times$/\1/p'); do
+		current="$(uci -q get "dawn.$section.update_beacon_reports" || true)"
+		if [ "$current" != "0" ]; then
+			uci set "dawn.$section.update_beacon_reports=0" || return 1
+			changed=1
+		fi
+	done
+
+	[ "$changed" -eq 0 ] || uci commit dawn
+}
+
